rules_version = '2';

// Daily Expense Buddy – Cloud Firestore security rules.
//
// Principles
// * Every document lives under users/{uid}; only the signed-in owner with a
//   verified email can read or write it. The uid comes from the auth token,
//   never from document data, so ownership cannot be reassigned.
// * Writes are schema-validated (allowed keys, types, ranges).
// * Expense updates must increment `version` by exactly one. An edit made
//   from stale data (e.g. offline on another device) is rejected instead of
//   silently overwriting a newer change.
// * Timestamps must be server timestamps (== request.time).
// * Premium entitlements can only be written by a trusted backend (Admin SDK
//   bypasses these rules); clients can read and delete their own.
// * Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Admins are identified by their verified sign-in email. To add one,
    // add the email here and deploy the rules.
    function isAdmin() {
      return verified()
        && request.auth.token.email in ['iamsurajdixit@gmail.com'];
    }

    function notBanned(uid) {
      return !exists(/databases/$(database)/documents/bans/$(uid));
    }

    // A banned account loses access to all of its data until unbanned.
    function isOwner(uid) {
      return verified()
        && request.auth.uid == uid
        && notBanned(uid);
    }

    function data() {
      return request.resource.data;
    }

    function daysInMonth(y, m) {
      return m == 2
        ? (((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) ? 29 : 28)
        : (m in [4, 6, 9, 11] ? 30 : 31);
    }

    // A real calendar date in YYYY-MM-DD form: 2025-02-31 and 2025-02-29
    // are rejected, 2024-02-29 is accepted.
    function isDate(v) {
      return v is string
        && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && v >= '2000-01-01'
        && int(v.split('-')[2]) <= daysInMonth(int(v.split('-')[0]), int(v.split('-')[1]));
    }

    function isCurrency(v) {
      return v is string && v.matches('^[A-Z]{3}$');
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    function isMinutes(v) {
      return v is int && v >= 0 && v < 1440;
    }

    // 1e12 major units at up to 3 decimal places.
    function isAmount(v) {
      return v is int && v > 0 && v <= 1000000000000000;
    }

    function ownEmail(d) {
      return !('email' in d) || d.email == request.auth.token.email;
    }

    match /users/{uid} {
      // Admins see profiles (name, email, join date) but never the
      // expenses or other data below them.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && data().keys().hasOnly(['displayName', 'email', 'createdAt', 'schemaVersion'])
        && data().displayName is string && data().displayName.size() <= 50
        && ownEmail(data())
        && data().createdAt == request.time
        && data().schemaVersion is int;
      allow update: if isOwner(uid)
        && data().diff(resource.data).affectedKeys().hasOnly(['displayName', 'email'])
        && data().displayName is string && data().displayName.size() <= 50
        && ownEmail(data());
      allow delete: if isOwner(uid);

      // ---------------------------------------------------------------
      match /expenses/{expenseId} {
        function validExpense(d) {
          return d.keys().hasOnly(['amountMinor', 'currency', 'categoryId', 'date',
                                   'note', 'merchant', 'paymentMethod',
                                   'createdAt', 'updatedAt', 'version'])
            && d.keys().hasAll(['amountMinor', 'currency', 'categoryId', 'date',
                                'createdAt', 'updatedAt', 'version'])
            && isAmount(d.amountMinor)
            && isCurrency(d.currency)
            && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 64
            && isDate(d.date)
            && optString(d, 'note', 200)
            && optString(d, 'merchant', 80)
            && (!('paymentMethod' in d) || d.paymentMethod == null
                || d.paymentMethod in ['cash', 'card', 'mobile', 'bank_transfer', 'wallet', 'other'])
            && d.version is int
            && d.updatedAt == request.time;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && expenseId.size() <= 64
          && validExpense(data())
          && data().createdAt == request.time
          && data().version == 1;
        allow update: if isOwner(uid)
          && validExpense(data())
          && data().createdAt == resource.data.createdAt
          && data().version == resource.data.version + 1;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && categoryId.size() <= 64
          && data().keys().hasOnly(['name', 'iconKey', 'colorIndex', 'archived', 'sortOrder', 'updatedAt'])
          && data().name is string && data().name.size() > 0 && data().name.size() <= 40
          && data().iconKey is string && data().iconKey.size() <= 32
          && data().colorIndex is int && data().colorIndex >= 0 && data().colorIndex < 12
          && data().archived is bool
          && data().sortOrder is int
          && data().updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().keys().hasOnly(['amountMinor', 'currency', 'categoryId', 'updatedAt'])
          && isAmount(data().amountMinor)
          && isCurrency(data().currency)
          && ((data().categoryId == null && budgetId == 'overall')
              || (data().categoryId is string && budgetId == 'cat_' + data().categoryId))
          && data().updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // One record per budget, month and threshold level; thresholds may only
      // increase so an alert cannot be re-triggered within a month.
      match /budget_alerts/{alertId} {
        function validAlert() {
          return data().keys().hasOnly(['monthKey', 'budgetId', 'threshold', 'updatedAt'])
            && data().monthKey is string && data().monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && data().budgetId is string && data().budgetId.size() <= 80
            && alertId == data().monthKey + '_' + data().budgetId
            && data().threshold is int && data().threshold > 0 && data().threshold <= 200
            && data().updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validAlert();
        allow update: if isOwner(uid) && validAlert()
          && data().threshold > resource.data.threshold;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      // Money lent to / borrowed from other people (just records; no money
      // moves). repaidMinor can never exceed the amount.
      match /loans/{loanId} {
        function validLoan(d) {
          return d.keys().hasOnly(['direction', 'personName', 'amountMinor', 'repaidMinor',
                                   'currency', 'date', 'dueDate', 'note', 'settled',
                                   'cancelled', 'createdAt', 'updatedAt'])
            && d.direction in ['lent', 'borrowed']
            && d.personName is string && d.personName.size() > 0 && d.personName.size() <= 60
            && isAmount(d.amountMinor)
            && d.repaidMinor is int && d.repaidMinor >= 0 && d.repaidMinor <= d.amountMinor
            && isCurrency(d.currency)
            && isDate(d.date)
            && (!('dueDate' in d) || d.dueDate == null || isDate(d.dueDate))
            && optString(d, 'note', 200)
            && d.settled is bool
            && (!('cancelled' in d) || d.cancelled is bool)
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && loanId.size() <= 64
          && validLoan(data())
          && data().createdAt == request.time;
        allow update: if isOwner(uid)
          && validLoan(data())
          && data().createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);

        // Repayment history. A repayment is only accepted in the same
        // atomic write that raises the loan's repaidMinor by exactly its
        // amount (and the loan rule caps repaidMinor at the loan amount),
        // so the history always adds up and can never overpay. Repayments
        // are immutable; they are deleted together with their loan.
        match /repayments/{repaymentId} {
          function loanPath() {
            return /databases/$(database)/documents/users/$(uid)/loans/$(loanId);
          }
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && repaymentId.size() <= 64
            && data().keys().hasOnly(['amountMinor', 'date', 'note', 'createdAt'])
            && isAmount(data().amountMinor)
            && isDate(data().date)
            && optString(data(), 'note', 200)
            && data().createdAt == request.time
            && exists(loanPath())
            && getAfter(loanPath()).data.repaidMinor
                 == get(loanPath()).data.repaidMinor + data().amountMinor;
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // ---------------------------------------------------------------
      // Premium features: creating or changing them needs an active
      // entitlement (granted only by an admin). Reading and deleting stay
      // possible after premium ends, so nothing is ever locked away.
      function premiumActive() {
        let ent = /databases/$(database)/documents/users/$(uid)/entitlements/premium;
        return exists(ent)
          && get(ent).data.active == true
          && get(ent).data.expiresAt > request.time;
      }

      match /recurring/{id} {
        function validRecurring(d) {
          return d.keys().hasOnly(['amountMinor', 'currency', 'categoryId', 'frequency',
                                   'startDate', 'merchant', 'note', 'paymentMethod',
                                   'lastPostedDate', 'active', 'createdAt', 'updatedAt'])
            && isAmount(d.amountMinor)
            && isCurrency(d.currency)
            && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 64
            && d.frequency in ['weekly', 'monthly', 'yearly']
            && isDate(d.startDate)
            && optString(d, 'merchant', 80)
            && optString(d, 'note', 200)
            && (!('paymentMethod' in d) || d.paymentMethod == null
                || d.paymentMethod in ['cash', 'card', 'mobile', 'bank_transfer', 'wallet', 'other'])
            && (!('lastPostedDate' in d) || d.lastPostedDate == null || isDate(d.lastPostedDate))
            && d.active is bool
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && premiumActive()
          && id.size() <= 64
          && validRecurring(data())
          && data().createdAt == request.time;
        allow update: if isOwner(uid) && premiumActive()
          && validRecurring(data())
          && data().createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /goals/{id} {
        function validGoal(d) {
          return d.keys().hasOnly(['name', 'targetMinor', 'savedMinor', 'currency',
                                   'targetDate', 'createdAt', 'updatedAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 60
            && isAmount(d.targetMinor)
            && d.savedMinor is int && d.savedMinor >= 0 && d.savedMinor <= 1000000000000000
            && isCurrency(d.currency)
            && (!('targetDate' in d) || d.targetDate == null || isDate(d.targetDate))
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && premiumActive()
          && id.size() <= 64
          && validGoal(data())
          && data().createdAt == request.time;
        allow update: if isOwner(uid) && premiumActive()
          && validGoal(data())
          && data().createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      match /daily_status/{day} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().keys().hasOnly(['date', 'status', 'updatedAt'])
          && isDate(data().date) && data().date == day
          && data().status in ['completed', 'no_expenses']
          && data().updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      match /settings/{docId} {
        function validReminders(r) {
          return r is map
            && r.keys().hasOnly(['enabled', 'timeMinutes', 'followUpsEnabled', 'followUpMinutes',
                                 'quietHoursEnabled', 'quietStartMinutes', 'quietEndMinutes'])
            && r.enabled is bool
            && isMinutes(r.timeMinutes)
            && r.followUpsEnabled is bool
            && r.followUpMinutes is list && r.followUpMinutes.size() <= 3
            && r.quietHoursEnabled is bool
            && isMinutes(r.quietStartMinutes)
            && isMinutes(r.quietEndMinutes);
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'preferences'
          && data().keys().hasOnly(['currencyCode', 'weekStart', 'formatLocale', 'reminders',
                                    'budgetAlertThresholds', 'updatedAt'])
          && isCurrency(data().currencyCode)
          && data().weekStart is int && data().weekStart >= 1 && data().weekStart <= 7
          && (data().formatLocale == null
              || (data().formatLocale is string && data().formatLocale.size() <= 20))
          && validReminders(data().reminders)
          && data().budgetAlertThresholds is list && data().budgetAlertThresholds.size() <= 6
          && data().updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // ---------------------------------------------------------------
      // Written only by a trusted backend (e.g. a purchase-verification
      // Cloud Function using the Admin SDK).
      // Premium is granted only by an admin (after approving a trial or a
      // verified UPI payment) or a trusted backend using the Admin SDK.
      match /entitlements/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
        allow create, update: if isAdmin()
          && docId == 'premium'
          && data().keys().hasOnly(['active', 'expiresAt', 'source', 'grantedBy',
                                    'pricePaise', 'updatedAt'])
          && data().active is bool
          && data().expiresAt is timestamp
          && data().expiresAt <= request.time + duration.value(800, 'd')
          && data().source in ['trial', 'upi', 'manual']
          && data().grantedBy == request.auth.token.email
          && (!('pricePaise' in data()) || (data().pricePaise is int && data().pricePaise >= 0))
          && data().updatedAt == request.time;
      }
    }
  
    // ---------------------------------------------------------------
    // Membership: bans, premium settings and premium requests.

    match /admin/probe {
      // The app reads this to find out whether the account is an admin.
      allow get: if isAdmin();
    }

    match /bans/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && data().keys().hasOnly(['reason', 'bannedAt', 'bannedBy'])
        && optString(data(), 'reason', 300)
        && data().bannedAt == request.time
        && data().bannedBy == request.auth.token.email;
    }

    match /app_config/premium {
      allow get: if verified();
      allow create, update: if isAdmin()
        && data().keys().hasOnly(['pricePaise', 'upiId', 'payeeName', 'trialDays', 'updatedAt'])
        && data().pricePaise is int && data().pricePaise >= 100 && data().pricePaise <= 10000000
        && data().upiId is string && data().upiId.size() <= 100
        && data().payeeName is string && data().payeeName.size() <= 60
        && data().trialDays is int && data().trialDays >= 1 && data().trialDays <= 30
        && data().updatedAt == request.time;
    }

    // A user may send any number of requests; admins see how many each
    // user has sent. Users can never approve their own.
    match /premium_requests/{requestId} {
      allow get: if isAdmin() || (verified() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (verified() && resource.data.uid == request.auth.uid);
      allow create: if isOwner(request.auth.uid)
        && data().keys().hasOnly(['uid', 'email', 'displayName', 'type', 'status',
                                  'message', 'upiRef', 'amountPaise', 'createdAt'])
        && data().uid == request.auth.uid
        && data().email == request.auth.token.email
        && data().displayName is string && data().displayName.size() <= 50
        && data().status == 'pending'
        && data().createdAt == request.time
        && optString(data(), 'message', 300)
        && (
          (data().type == 'trial'
            && !('upiRef' in data()) && !('amountPaise' in data()))
          || (data().type == 'payment'
            && data().upiRef is string
            && data().upiRef.size() >= 6 && data().upiRef.size() <= 40
            && data().amountPaise is int && data().amountPaise > 0)
        );
      allow update: if isAdmin()
        && data().diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt', 'decidedBy', 'adminNote'])
        && data().status in ['approved', 'rejected']
        && data().decidedAt == request.time
        && data().decidedBy == request.auth.token.email
        && optString(data(), 'adminNote', 300);
      allow delete: if false;
    }
  }
}
